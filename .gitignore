# --- Secrets & data hygiene (2026-05-21, post .env.dev leak) ---
# never commit any env file except the example template
**/.env
**/.env.*
!**/.env.example
# SOPS+age-encrypted env twins ARE safe to commit (only the age-key holder can
# decrypt). Re-include them after the broad **/.env.* ignore above. Manage with
# app1/family-fund-app/bin/secrets.sh; recipients in .sops.yaml.
!**/*.sops
# data dumps / raw DB files / logs (the leak class)
database/dev/*.sql
database/**/*data*.sql
database/prod_to_dev.sql
**/*.sql.gz
**/*.ibd
**/*.frm
**/*.sqlite
**/*.log
**/*.log.*
database/csv/*password*
**/datadir*/

# --- Local tooling & scratch dirs (never committed) ---
/.claude/worktrees/
/.codex-worktrees/
/.playwright-cli/
/output/

# IDE config (machine-/user-specific; e.g. .idea/dataSources.xml held internal JDBC hosts)
.idea/

# --- Dev artifacts that must never re-creep (#35) ---
# stray localhost session jar + QA screenshot dumps (contain real account data)
cookies.txt
docs/qa-shots-*/
