APP_NAME="Family Fund Dev"
APP_ENV=dev
APP_KEY=
APP_DEBUG=true
# APP_URL must include the host port the dev stack publishes on (default 3000;
# the compose override may map a different port — keep this in sync with
# ${FF_APP_PORT}). The password-reset mailer renders absolute links from this
# value, so a wrong port produces unreachable reset links.
APP_URL=http://localhost:3000

LOG_CHANNEL=stack
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

DB_CONNECTION=mariadb
DB_HOST=mariadb
DB_PORT=3306
DB_DATABASE=familyfund_dev
DB_USERNAME=root
DB_PASSWORD=

BROADCAST_DRIVER=log
CACHE_DRIVER=file
FILESYSTEM_DRIVER=local
QUEUE_CONNECTION=database
SESSION_DRIVER=file
SESSION_LIFETIME=120

MEMCACHED_HOST=127.0.0.1

REDIS_HOST=127.0.0.1
REDIS_PASSWORD=
REDIS_PORT=6379

MAIL_MAILER=smtp
# MAIL_DRIVER=smtp

# Dev: route mail to the local Mailpit container (compose service key "mailhog").
# Host MUST be the compose service name, not a container_name.
MAIL_HOST=mailhog
MAIL_PORT=1025
MAIL_USERNAME=null
MAIL_PASSWORD=
MAIL_ENCRYPTION=null
# MAIL_SENDMAIL_PATH unused (MAIL_MAILER=smtp); mhsendmail is MailHog-only, absent in Mailpit.

# Gmail SMTP — disabled for dev (kept for reference / non-dev envs).
# Fill these in locally; never commit real values to this template.
# MAIL_HOST=smtp.gmail.com
# MAIL_PORT=465
# MAIL_USERNAME=
# MAIL_PASSWORD_ENCRYPTED=
# MAIL_ENCRYPTION=ssl

MAIL_FROM_ADDRESS=hello@example.com
# Admin recipient for system mailers + scheduled-job failure alerts.
MAIL_ADMIN_ADDRESS=admin@example.com
MAIL_FROM_NAME="${APP_NAME}"

# Comma-separated emails treated as application admins, in addition to users
# holding the System Admin role (config/familyfund.php). Default is the non-PII
# dev admin that prod_to_dev.sql renames the admin to (#79). Set the real operator
# address here in your local (git-ignored) .env; keep this template synthetic.
ADMIN_EMAILS=admin@dev.familyfund.local

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false

PUSHER_APP_ID=
PUSHER_APP_KEY=
PUSHER_APP_SECRET=
PUSHER_APP_CLUSTER=mt1

MIX_PUSHER_APP_KEY=
MIX_PUSHER_APP_CLUSTER="${PUSHER_APP_CLUSTER}"
QUICKCHART_PUBLIC_URL=http://localhost:3400
